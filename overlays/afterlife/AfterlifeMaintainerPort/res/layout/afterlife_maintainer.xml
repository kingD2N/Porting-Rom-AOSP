<?xml version="1.0" encoding="utf-8"?>
<!-- Pengganti layout afterlife_maintainer Settings AfterLife: tanpa foto (maintainer_img) dan tanpa
     tombol GitHub/Telegram/Facebook/Instagram. View ber-id github/telegram/facebook/instagram tetap
     ada (LinearLayout, gone) karena controller memasang click listener ke view itu. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="?android:attr/listPreferredItemPaddingEnd"
    android:paddingEnd="?android:attr/listPreferredItemPaddingEnd"
    android:layout_marginVertical="15dp">

    <FrameLayout
        android:id="@id/base_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="10dp"
        android:background="@drawable/port_maint_card"
        android:clipToOutline="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@id/fixed_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="?android:attr/listPreferredItemHeightSmall"
                android:orientation="horizontal"
                android:paddingStart="?android:attr/listPreferredItemPaddingStart"
                android:paddingEnd="?android:attr/listPreferredItemPaddingEnd">

                <RelativeLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp">

                    <ImageView
                        android:id="@id/status_icon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="16dp"
                        android:tint="@android:color/system_accent1_900" />

                    <TextView
                        android:id="@id/status_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@id/status_icon"
                        android:maxLines="2"
                        android:textColor="@android:color/system_accent1_800"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@id/maintained_by"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/status_text"
                        android:layout_toEndOf="@id/status_icon"
                        android:maxLines="1"
                        android:paddingEnd="5dp"
                        android:text="Keep Alive By"
                        android:textColor="@android:color/system_accent1_900"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@id/maintainer_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/status_text"
                        android:layout_toEndOf="@id/maintained_by"
                        android:maxLines="2"
                        android:textColor="@android:color/system_accent1_900"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <ImageView
                    android:id="@id/expand_button"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/port_maint_round"
                    android:padding="6dp"
                    android:src="@android:drawable/arrow_down_float"
                    android:tint="@android:color/system_accent1_800" />
            </LinearLayout>

            <LinearLayout
                android:id="@id/hidden_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/colorBackground"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@id/maintainer_name_expanded"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@id/device_model"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?android:attr/textColorSecondary" />

                <LinearLayout android:id="@id/github" android:layout_width="0dp" android:layout_height="0dp" android:orientation="vertical" android:visibility="gone" />
                <LinearLayout android:id="@id/telegram" android:layout_width="0dp" android:layout_height="0dp" android:orientation="vertical" android:visibility="gone" />
                <LinearLayout android:id="@id/facebook" android:layout_width="0dp" android:layout_height="0dp" android:orientation="vertical" android:visibility="gone" />
                <LinearLayout android:id="@id/instagram" android:layout_width="0dp" android:layout_height="0dp" android:orientation="vertical" android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
