<?xml version="1.0" encoding="utf-8"?>
<!-- Porting-Rom-AOSP: kartu maintainer AfterLife (Settings > Tentang ponsel) tanpa foto & link sosial
     media maintainer asli. Semua id yang dipakai afterlifeMaintainerController tetap ada. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.ingres.port.overlay.afterlife.maintainer">
    <overlay android:targetPackage="com.android.settings" android:isStatic="true" android:priority="900"
        android:resourcesMap="@xml/overlays" />
    <application android:hasCode="false" />
</manifest>
