; Dolby DAX (HAL vendor.dolby.hardware.dms@2.0)
; terjemahan CIL dari hardware/dolby/sepolicy/vendor (attributes, hal_dms.te, hal_dms_default.te,
; hal_audio.te, audioserver.te, mediacodec.te, platform_app.te, system_server.te) + priv_app
; (UI Dolby tanpa kunci platform donor berjalan sebagai priv_app).
; {nama} = type yang di-resolve dari policy vendor/plat (versi), {CLIENT} = tiap domain client.
; Baris yang type-nya tidak ada di policy dibuang otomatis oleh addon_tool.py.
(typeattribute hal_dms)
(expandtypeattribute (hal_dms) true)
(typeattribute hal_dms_client)
(expandtypeattribute (hal_dms_client) true)
(typeattribute hal_dms_server)
(expandtypeattribute (hal_dms_server) false)
(type hal_dms_default)
(roletype object_r hal_dms_default)
(type hal_dms_default_exec)
(roletype object_r hal_dms_default_exec)
(type hal_dms_hwservice)
(roletype object_r hal_dms_hwservice)
(typeattributeset domain (hal_dms_default))
(typeattributeset halserverdomain (hal_dms_default))
(typeattributeset hal_dms (hal_dms_default))
(typeattributeset hal_dms_server (hal_dms_default))
(typeattributeset file_type (hal_dms_default_exec))
(typeattributeset exec_type (hal_dms_default_exec))
(typeattributeset vendor_file_type (hal_dms_default_exec))
(typeattributeset hwservice_manager_type (hal_dms_hwservice))
; init_daemon_domain(hal_dms_default)
(allow {init} hal_dms_default_exec (file (read getattr map execute open)))
(allow {init} hal_dms_default (process (transition)))
(allow hal_dms_default hal_dms_default_exec (file (read getattr map execute open entrypoint)))
(dontaudit {init} hal_dms_default (process (noatsecure)))
(allow {init} hal_dms_default (process (siginh rlimitinh)))
(typetransition {init} hal_dms_default_exec process hal_dms_default)
; hal_client_domain({CLIENT}, hal_dms)
(typeattributeset halclientdomain ({CLIENT}))
(typeattributeset hal_dms_client ({CLIENT}))
; hal_dms.te: binder_call(client, server), binder_call(server, client), add_hwservice
(allow hal_dms_client hal_dms_server (binder (call transfer)))
(allow hal_dms_server hal_dms_client (binder (transfer)))
(allow hal_dms_client hal_dms_server (fd (use)))
(allow hal_dms_server hal_dms_client (binder (call transfer)))
(allow hal_dms_client hal_dms_server (binder (transfer)))
(allow hal_dms_server hal_dms_client (fd (use)))
(allow hal_dms_server hal_dms_hwservice (hwservice_manager (add find)))
(allow hal_dms_server {hidl_base_hwservice} (hwservice_manager (add)))
(allow hal_dms_client hal_dms_hwservice (hwservice_manager (find)))
; hal_dms_default.te
(allow hal_dms_default {vendor_data_file} (dir (ioctl read write getattr lock open watch watch_reads add_name remove_name search)))
(allow hal_dms_default {vendor_data_file} (file (ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads)))
(allow hal_dms_default {mediacodec} (binder (call)))
(allow hal_dms_default {CLIENT} (binder (call transfer)))
(allow {CLIENT} hal_dms_default (binder (transfer)))
(allow hal_dms_default {CLIENT} (fd (use)))
; set_prop(hal_dms_default, vendor_audio_prop)
(allow hal_dms_default {property_socket} (sock_file (write)))
(allow hal_dms_default {init} (unix_stream_socket (connectto)))
(allow hal_dms_default {vendor_audio_prop} (property_service (set)))
(allow hal_dms_default {vendor_audio_prop} (file (ioctl read getattr lock map open watch watch_reads)))
; hal_audio.te / mediacodec.te
(allow {hal_audio_default} hal_dms_default (binder (call transfer)))
(allow hal_dms_default {hal_audio_default} (binder (transfer)))
(allow {hal_audio_default} hal_dms_default (fd (use)))
(allow {hal_audio_default} hal_dms_hwservice (hwservice_manager (find)))
(allow {mediacodec} hal_dms_hwservice (hwservice_manager (find)))
